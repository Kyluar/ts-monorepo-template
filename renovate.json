{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "schedule": ["before 8am on Monday"],
  "prConcurrentLimit": 3,
  "automergeType": "pr",
  "commitMessagePrefix": "🏗️ build(deps):",
  "commitMessageAction": "update",
  "commitMessageTopic": "{{{depName}}}",
  "commitMessageExtra": "from {{{currentVersion}}} to {{{newVersion}}}",
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^\\.nvmrc$"],
      "matchStrings": ["(?<currentValue>[\\d\\.]+)"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version"
    },
    {
      "customType": "regex",
      "fileMatch": ["^ci/src/images\\.ts$"],
      "matchStrings": ["\"(?<depName>[^@:\"]+):(?<currentValue>[^@\"]+)@sha256:(?<currentDigest>[a-f0-9]+)\""],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "fileMatch": ["^ci/utils/src/images\\.ts$"],
      "matchStrings": [
        "// renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\n]+)\\nexport const \\w+ = \"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "fileMatch": ["^package\\.json$"],
      "matchStrings": ["\"packageManager\":\\s*\"pnpm@(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "pnpm",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "groupName": "react",
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "commitMessageTopic": "react packages"
    },
    {
      "matchFileNames": ["ci/src/images.ts"],
      "automerge": false,
      "dependencyDashboardApproval": true,
      "description": "Imagens de segurança (semgrep, trufflehog) requerem aprovação manual"
    },
    {
      "matchPackageNames": ["node", "pnpm"],
      "automerge": false,
      "dependencyDashboardApproval": true,
      "groupName": "runtime versions",
      "description": "Agrupa .nvmrc, engines.node e packageManager pnpm no mesmo PR — requerem aprovação manual"
    },
    {
      "matchFileNames": ["ci/package.json", "ci/utils/package.json"],
      "matchPackageNames": ["typescript"],
      "enabled": false
    }
  ]
}
