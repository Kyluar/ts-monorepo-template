{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "schedule": ["before 8am on Monday"],
  "prConcurrentLimit": 3,
  "rebaseWhen": "behind-base-branch",
  "automergeType": "pr",
  "platformAutomerge": true,
  "commitMessagePrefix": "🏗️ build(deps):",
  "commitMessageAction": "update",
  "commitMessageTopic": "{{{depName}}}",
  "commitMessageExtra": "from {{{currentVersion}}} to {{{newVersion}}}",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.nvmrc$/"],
      "matchStrings": ["(?<currentValue>[\\d\\.]+)"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ci/src/images\\.ts$/"],
      "matchStrings": ["\"(?<depName>[^@:\"]+):(?<currentValue>[^@\"]+)@sha256:(?<currentDigest>[a-f0-9]+)\""],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ci/utils/src/images\\.ts$/"],
      "matchStrings": [
        "// renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\n]+)\\nexport const \\w+ = \"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^package\\.json$/"],
      "matchStrings": ["\"packageManager\":\\s*\"pnpm@(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "pnpm",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "groupName": "react",
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "commitMessageTopic": "react packages"
    },
    {
      "groupName": "vitest",
      "matchPackageNames": ["vite", "@vitejs/plugin-react", "vitest", "@vitest/coverage-v8"],
      "commitMessageTopic": "vitest packages"
    },
    {
      "matchFileNames": ["ci/src/images.ts"],
      "automerge": false,
      "dependencyDashboardApproval": true,
      "description": "Imagens de segurança (semgrep, trufflehog, trivy) requerem aprovação manual"
    },
    {
      "matchPackageNames": ["node", "pnpm"],
      "automerge": false,
      "dependencyDashboardApproval": true,
      "groupName": "runtime versions",
      "description": "Agrupa .nvmrc, engines.node e packageManager pnpm no mesmo PR — requerem aprovação manual"
    },
    {
      "matchFileNames": ["ci/package.json", "ci/utils/package.json"],
      "matchPackageNames": ["typescript"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@biomejs/biome"],
      "postUpgradeTasks": {
        "commands": ["pnpm exec biome migrate --write"],
        "executionMode": "branch"
      }
    }
  ]
}
